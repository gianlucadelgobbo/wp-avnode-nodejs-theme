extends layout
block banner
  .container
    .hy-banner
      h2.hy-banner__name!=global.__('promo-title')
      .hy-banner__text
        !=global.__('promo-l1')
        br
        !=global.__('promo-l2')
        br
        !=global.__('promo-l3')
block content
  mixin calCardSwiper(item)
    - var href = item.link ? '/calendar/'+item.slug+'/' : '/editions/'+item.slug+'/'
    .swiper-slide
      .boxItem(itemprop="itemListElement", itemscope, itemtype="http://schema.org/ListItem")
        .Event(itemprop="item", itemscope, itemtype='http://schema.org/Event')
          .thumb-cnt(itemprop='image', itemscope, itemtype="http://schema.org/ImageObject")
            .thumb-cnt-cnt
              a(href=href, rel='bookmark', title!=item.title, itemprop='url')
                img.img-fluid(src=item.image, alt!=item.title, itemprop='contentUrl')
          .box-list
            .text-center
              .text-muted.supText=item.data_evento
              h3.list_title(itemprop='name')!=item.title
            .read-more-box
              a(href=href, rel='bookmark', title!=item.title, itemprop='url')
                .sr-only=global.__("Read More")
                i.icon-right

  if carousel && carousel.length
    #mycarousel.carousel.slide(data-ride='carousel', data-interval="3000")
      ol.carousel-indicators
        each item, i in carousel
          li(data-target='#mycarousel', data-slide-to=i, class=i===0?'active':'')
      .carousel-inner
        each item, i in carousel
          .carousel-item(class=i===0?'active':'')
            if item.link
              a(href=item.link, title=item.alt)
                img.d-block.w-100(src=item.src, alt=item.alt)
            else
              img.d-block.w-100(src=item.src, alt=item.alt)
      a.carousel-control-prev(href='#mycarousel', role='button', data-slide='prev')
        span.carousel-control-prev-icon(aria-hidden='true')
        span.sr-only=global.__('Previous slide')
      a.carousel-control-next(href='#mycarousel', role='button', data-slide='next')
        span.carousel-control-next-icon(aria-hidden='true')
        span.sr-only=global.__('Nexts slide')

  if today && today.length
    section.home-section.mt-5(itemscope itemtype='http://schema.org/ItemList')
      h2.entry-title(itemprop="name")=global.__('Today at MAM')
      .swiper-container
        .swiper-wrapper
          each item in today
            +calCardSwiper(item)

  if upcoming && upcoming.length
    section.home-section.mt-5(itemscope itemtype='http://schema.org/ItemList')
      h2.entry-title(itemprop="name")=global.__('Upcoming Events')
      .swiper-container
        .swiper-wrapper
          each item in upcoming
            +calCardSwiper(item)
      .text-right.mt-2
        a.btn.btn-outline-primary.btn-sm(href=lang_preurl+'/calendar/')=global.__('See all events')

  section.home-section.mt-5
    h2.entry-title=global.__('Explore MAM')
    .row
      .col-md-3.col-sm-6.mb-4
        .card.h-100.bg-dark
          .card-body.d-flex.flex-column
            h5.card-title=global.__('Academy')
            p.card-text=global.__('Training, workshops and artistic residencies.')
            a.btn.btn-primary.btn-sm.mt-auto(href=lang_preurl+'/academy/')=global.__('Discover')
      .col-md-3.col-sm-6.mb-4
        .card.h-100.bg-dark
          .card-body.d-flex.flex-column
            h5.card-title=global.__('Education')
            p.card-text=global.__('Educational programs for schools and families.')
            a.btn.btn-primary.btn-sm.mt-auto(href=lang_preurl+'/education/')=global.__('Discover')
      .col-md-3.col-sm-6.mb-4
        .card.h-100.bg-dark
          .card-body.d-flex.flex-column
            h5.card-title=global.__('Collection')
            p.card-text=global.__('Explore the permanent collection.')
            a.btn.btn-primary.btn-sm.mt-auto(href=lang_preurl+'/collection/')=global.__('Discover')
      .col-md-3.col-sm-6.mb-4
        .card.h-100.bg-dark
          .card-body.d-flex.flex-column
            h5.card-title=global.__('Tickets')
            p.card-text=global.__('Buy tickets online, choose your date and time.')
            a.btn.btn-primary.btn-sm.mt-auto(href=lang_preurl+'/tickets/')=global.__('Buy Tickets')

  section.home-section.mt-5(itemscope itemtype='http://schema.org/ItemList')
    h2.entry-title(itemprop="name")=global.__('News')
    .swiper-container
      if results && results.news
        !=results.news.replace(new RegExp("col-xl-3 col-lg-4 col-md-6 col-sm-6 col-xs-12 isotopeitem", 'g'), "swiper-slide").replace(new RegExp("row isotope results", 'g'), "swiper-wrapper").replace(new RegExp("pagination pagination-sm justify-content-center", 'g'), "pagination pagination-sm justify-content-center d-none")
    .text-right.mt-2
      a.btn.btn-primary.btn-sm(href=lang_preurl+'/news/')=global.__('See all News')
