extends layout
block content
  style.
    #navbar-top, header, nav.text-right { display: none !important; }
    .cnt { padding: 0 !important; }
    .container { max-width: 100% !important; padding: 0 !important; margin: 0 !important; }
    .carousel, .carousel-inner, .carousel-item { height: 100vh; }
    .carousel-item img { width: 100vw; height: 100vh; object-fit: cover; }
  #mycarousel.carousel.slide(data-ride='carousel', data-interval='5000')
    .carousel-inner
      each item, i in carousel
        .carousel-item(class=i===0?'active':'')
          img.d-block.w-100(src=item.src, alt=item.alt)
    script.
      function goFullscreen() {
        if (document.fullscreenElement || document.webkitFullscreenElement) return;

        const el = document.documentElement;
        const request = el.requestFullscreen || el.webkitRequestFullscreen;

        if (request) {
          try {
            const result = request.call(el);
            if (result && result.catch) result.catch(() => {});
          } catch (e) {}
        }
      }

      // Clic reale: attiva o ripristina il fullscreen
      document.addEventListener('click', goFullscreen);

      // Ogni 30 secondi: tenta di ripristinarlo
      setInterval(goFullscreen, 30000);