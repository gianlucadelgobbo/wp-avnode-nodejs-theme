extends layout
block content
  - var ticketsUrl = lang_preurl+'/tickets/'

  - var heroImgs = ['SELECTA-HM-00','SELECTA-HM-01','SELECTA-HM-02','SELECTA-HM-03','SELECTA-HM-04','SELECTA-HM-05','SELECTA-HM-06','SELECTA-HM-07']
  - var heroBase = 'https://admin.mediaartmuseum.org/wp-content/uploads/2026/09/'

  section.hy-hero
    .hy-hero__bg
      #hyCarousel.carousel.slide(data-ride='carousel', data-interval='4000', data-pause='false')
        .carousel-inner
          each img, i in heroImgs
            .carousel-item(class=i===0?'active':'')
              img.hy-hero__bg-img(src=heroBase+img+'.jpg', alt=page_data.title+' '+img)
    .hy-hero__overlay
    .hy-hero__content.container
      h1.hy-hero__title
        img.img-fluid(itemprop='image', src='https://admin.mediaartmuseum.org/wp-content/uploads/2026/08/HyperMedia-logo-web.svg', alt='HyperMedia')
      if result['wpcf-subtitle']
        p.hy-hero__subtitle!=result['wpcf-subtitle']
      a.btn.btn-primary.btn-lg.hy-hero__cta(href=ticketsUrl)=global.__('Buy Tickets')
      .hy-hero__tags
        span.hy-hero__tag=global.__('Immersive Art')
        span.hy-hero__tag=global.__('AI Art')
        span.hy-hero__tag=global.__('Net Art')

  section.hy-intro
    .container
      .text-center!=result.post_content

  section.hy-experience
    .container
      h2.hy-section-title=global.__('The Experience')
      .row
        .col-md-4.mb-4
          .hy-exp-card
            if result.featured && result.featured.thumbnail
              img.hy-exp-card__img(src=result.featured.thumbnail, alt=global.__('Immersive Art'))
            .hy-exp-card__title=global.__('Immersive Art')
            p.hy-exp-card__desc=global.__('Monumental projections that transform architecture into living art.')
        .col-md-4.mb-4
          .hy-exp-card
            if result.featured && result.featured.thumbnail
              img.hy-exp-card__img(src=result.featured.thumbnail, alt=global.__('AI Art'))
            .hy-exp-card__title=global.__('AI Art')
            p.hy-exp-card__desc=global.__('Artificial intelligence creating immersive experiences.')
        .col-md-4.mb-4
          .hy-exp-card
            if result.featured && result.featured.thumbnail
              img.hy-exp-card__img(src=result.featured.thumbnail, alt=global.__('Net Art'))
            .hy-exp-card__title=global.__('Net Art')
            p.hy-exp-card__desc=global.__('Interactive digital installations that explore the relationship between technology and art.')

  section.hy-info
    .container
      .hy-info__block
        .hy-info__content
          h2.hy-section-title=global.__('Info')
          ul.how-to-buy
            li.how-to-buy__item
              .how-to-buy__item--container
                svg(xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true' focusable='false' viewBox='0 0 448 512')
                  path(fill='currentColor' d='M128 0c17.7 0 32 14.3 32 32V64H288V32c0-17.7 14.3-32 32-32s32 14.3 32 32V64h48c26.5 0 48 21.5 48 48v48H0V112C0 85.5 21.5 64 48 64H96V32c0-17.7 14.3-32 32-32zM0 192H448V464c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V192zm64 80v32c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16V272c0-8.8-7.2-16-16-16H80c-8.8 0-16 7.2-16 16zm128 0v32c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16V272c0-8.8-7.2-16-16-16H208c-8.8 0-16 7.2-16 16zm144-16c-8.8 0-16 7.2-16 16v32c0 8.8 7.2 16 16 16h32c8.8 0 16-7.2 16-16V272c0-8.8-7.2-16-16-16H336z')
                span.how-to-buy__title=global.__('Date')+':'
              span=result.data_evento
            li.how-to-buy__item
              .how-to-buy__item--container
                svg(xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true' focusable='false' viewBox='0 0 384 512')
                  path(fill='currentColor' d='M32 0C14.3 0 0 14.3 0 32S14.3 64 32 64V75c0 42.4 16.9 83.1 46.9 113.1L146.7 256 78.9 323.9C48.9 353.9 32 394.6 32 437v11c-17.7 0-32 14.3-32 32s14.3 32 32 32H64 320h32c17.7 0 32-14.3 32-32s-14.3-32-32-32V437c0-42.4-16.9-83.1-46.9-113.1L237.3 256l67.9-67.9c30-30 46.9-70.7 46.9-113.1V64c17.7 0 32-14.3 32-32s-14.3-32-32-32H320 64 32z')
                span.how-to-buy__title=global.__('Opening Hours')+':'
              span —
            li.how-to-buy__item
              .how-to-buy__item--container
                svg(xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true' focusable='false' viewBox='0 0 384 512')
                  path(fill='currentColor' d='M32 0C14.3 0 0 14.3 0 32S14.3 64 32 64V75c0 42.4 16.9 83.1 46.9 113.1L146.7 256 78.9 323.9C48.9 353.9 32 394.6 32 437v11c-17.7 0-32 14.3-32 32s14.3 32 32 32H64 320h32c17.7 0 32-14.3 32-32s-14.3-32-32-32V437c0-42.4-16.9-83.1-46.9-113.1L237.3 256l67.9-67.9c30-30 46.9-70.7 46.9-113.1V64c17.7 0 32-14.3 32-32s-14.3-32-32-32H320 64 32z')
                span.how-to-buy__title=global.__('Duration')+':'
              span —
            li.how-to-buy__item
              .how-to-buy__item--container
                svg(xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true' focusable='false' viewBox='0 0 384 512')
                  path(fill='currentColor' d='M215.7 499.2C267 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 128a64 64 0 1 1 0 128 64 64 0 1 1 0-128z')
                span.how-to-buy__title=global.__('Location')+':'
              span —
            li.how-to-buy__item
              .how-to-buy__item--container
                svg(xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true' focusable='false' viewBox='0 0 576 512')
                  path(fill='currentColor' d='M0 112.5V422.3c0 18 10.1 35 27 41.3c87 32.5 174 10.3 261-11.9c79.8-20.3 159.6-40.7 239.3-18.9c23 6.3 48.7-9.5 48.7-33.4V89.7c0-18-10.1-35-27-41.3C462 15.9 375 38.1 288 60.3C208.2 80.6 128.4 100.9 48.7 79.1C25.6 72.8 0 88.6 0 112.5zM288 352c-44.2 0-80-43-80-96s35.8-96 80-96s80 43 80 96s-35.8 96-80 96z')
                span.how-to-buy__title=global.__('Price')+':'
              span —
            li.how-to-buy__item
              .how-to-buy__item--container
                svg(xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true' focusable='false' viewBox='0 0 512 512')
                  path(fill='currentColor' d='M192 96a48 48 0 1 0 0-96 48 48 0 1 0 0 96zM120.5 247.2c12.4-4.7 18.7-18.5 14-30.9s-18.5-18.7-30.9-14C43.1 225.1 0 283.5 0 352c0 88.4 71.6 160 160 160c61.2 0 114.3-34.3 141.2-84.7c6.2-11.7 1.8-26.2-9.9-32.5s-26.2-1.8-32.5 9.9C240 440 202.8 464 160 464C98.1 464 48 413.9 48 352c0-47.9 30.1-88.8 72.5-104.8z')
                span.how-to-buy__title=global.__('Minimum age')+':'
              span —
            li.how-to-buy__item
              .how-to-buy__item--container
                svg(xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true' focusable='false' viewBox='0 0 512 512')
                  path(fill='currentColor' d='M192 96a48 48 0 1 0 0-96 48 48 0 1 0 0 96zM120.5 247.2c12.4-4.7 18.7-18.5 14-30.9s-18.5-18.7-30.9-14C43.1 225.1 0 283.5 0 352c0 88.4 71.6 160 160 160c61.2 0 114.3-34.3 141.2-84.7c6.2-11.7 1.8-26.2-9.9-32.5s-26.2-1.8-32.5 9.9C240 440 202.8 464 160 464C98.1 464 48 413.9 48 352c0-47.9 30.1-88.8 72.5-104.8z')
                span.how-to-buy__title=global.__('Accessibility')+':'
              span —
            li.how-to-buy__item
              .how-to-buy__item--container
                svg(xmlns='http://www.w3.org/2000/svg' role='img' aria-hidden='true' focusable='false' viewBox='0 0 576 512')
                  path(fill='currentColor' d='M64 64C28.7 64 0 92.7 0 128v64c0 8.8 7.4 15.7 15.7 18.6C34.5 217.1 48 235 48 256s-13.5 38.9-32.3 45.4C7.4 304.3 0 311.2 0 320v64c0 35.3 28.7 64 64 64H512c35.3 0 64-28.7 64-64V320c0-8.8-7.4-15.7-15.7-18.6C541.5 294.9 528 277 528 256s13.5-38.9 32.3-45.4c8.3-2.9 15.7-9.8 15.7-18.6V128c0-35.3-28.7-64-64-64H64z')
                span.how-to-buy__title=global.__('Ticket types')+':'
              span —
          a.btn.btn-primary.btn-lg.mt-4(href=ticketsUrl)=global.__('Buy Tickets')
        if result.featured && result.featured.full
          .hy-info__visual
            img.hy-info__img(src=result.featured.full, alt=page_data.title)

  section.hy-program.container.mt-5
    h2.hy-section-title=global.__('Program')
    include ../_partials/inc_grid
