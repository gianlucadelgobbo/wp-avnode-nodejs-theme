extends layout
block content
  - var ticketsUrl = lang_preurl+'/tickets/'

  - var heroImgs = ['SELECTA-HM-00','SELECTA-HM-01','SELECTA-HM-02','SELECTA-HM-04','SELECTA-HM-05','SELECTA-HM-06','SELECTA-HM-07']
  - var heroBase = 'https://admin.mediaartmuseum.org/wp-content/uploads/2026/09/'

  section.hy-hero
    .hy-hero__bg
      #hyCarousel.carousel.slide(data-ride='carousel', data-interval='4000', data-pause='false')
        .carousel-inner
          each img, i in heroImgs
            .carousel-item(class=i===0?'active':'')
              img.hy-hero__bg-img(src=heroBase+img+'.jpg', alt=page_data.title+' '+img)
    .hy-hero__overlay
    .hy-hero__content.container
      h1.hy-hero__title
        img.img-fluid(itemprop='image', src='https://admin.mediaartmuseum.org/wp-content/uploads/2026/08/HyperMedia-logo-web.svg', alt='HyperMedia')
      if result['wpcf-subtitle']
        p.hy-hero__subtitle!=result['wpcf-subtitle']
      a.btn.btn-primary.btn-lg.hy-hero__cta(href=ticketsUrl)=global.__('Buy Tickets')
      .hy-hero__tags
        span.hy-hero__tag=global.__('Immersive Art')
        span.hy-hero__tag=global.__('AI Art')
        span.hy-hero__tag=global.__('Net Art')

  section.hy-intro
    .container
      .row
        .col-md-3.mb-4
        .col-md-6.mb-4
          .text-center!=result.post_content

  section.hy-experience
    .container
      h2.hy-section-title.text-center=global.__('The Experience')
      .row
        .col-md-4.mb-4
          .hy-exp-card
            if result.featured && result.featured.thumbnail
              img.hy-exp-card__img(src="https://admin.mediaartmuseum.org/wp-content/uploads/2026/09/SELECTA-HM-immersive.jpg", alt=global.__('Immersive Art'))
            .hy-exp-card__title=global.__('Immersive Art')
            p.hy-exp-card__desc=global.__('The artwork expands beyond the screen, transforming image, sound, code and space into an environment the audience can enter.')
        .col-md-4.mb-4
          .hy-exp-card
            if result.featured && result.featured.thumbnail
              img.hy-exp-card__img(src="https://admin.mediaartmuseum.org/wp-content/uploads/2026/09/SELECTA-HM-ai.jpg", alt=global.__('AI Art'))
            .hy-exp-card__title=global.__('AI Art')
            p.hy-exp-card__desc=global.__('Artificial intelligence as an artistic tool for generating, transforming and performing images, as part of a practice that spans decades.')
        .col-md-4.mb-4
          .hy-exp-card
            if result.featured && result.featured.thumbnail
              img.hy-exp-card__img(src="https://admin.mediaartmuseum.org/wp-content/uploads/2026/09/SELECTA-HM-net-art.jpg", alt=global.__('Net Art'))
            .hy-exp-card__title=global.__('Net Art')
            p.hy-exp-card__desc=global.__('The network becomes the medium and the space of the artwork, connecting code, images, links and interaction.')

