canvas#mam-loose-canvas(aria-hidden='true')
.mam-loose-wrap#mam-loose-wrap
  .mam-loose-btn#mam-loose-btn
    .mam-loose-btn__drag#mam-loose-drag(title='Drag')
      svg(width='10' height='16' viewBox='0 0 10 16' fill='currentColor' aria-hidden='true')
        circle(cx='2' cy='2' r='1.5')
        circle(cx='8' cy='2' r='1.5')
        circle(cx='2' cy='8' r='1.5')
        circle(cx='8' cy='8' r='1.5')
        circle(cx='2' cy='14' r='1.5')
        circle(cx='8' cy='14' r='1.5')
    .mam-loose-btn__toggle#mam-loose-toggle
      .mam-loose-btn__bars
        span.mam-loose-btn__bar
        span.mam-loose-btn__bar
        span.mam-loose-btn__bar
      span.mam-loose-btn__label LOOSE TIME
  .mam-loose-panel#mam-loose-panel(hidden)
    .mam-loose-panel__row
      label(for='lt-r')=global.__('Interference area')
      output#lt-rv
      input#lt-r(type='range' min='20' max='820' value='420')
    .mam-loose-panel__row
      label(for='lt-f')=global.__('Repulsion force')
      output#lt-fv
      input#lt-f(type='range' min='0' max='600' value='300')
    .mam-loose-panel__row
      label(for='lt-k')=global.__('Return')
      output#lt-kv
      input#lt-k(type='range' min='1' max='199' value='100')
    .mam-loose-panel__row
      label(for='lt-d')=global.__('Damping')
      output#lt-dv
      input#lt-d(type='range' min='980' max='1000' value='990')
    .mam-loose-panel__row
      label(for='lt-b')=global.__('Buoyancy')
      output#lt-bv
      input#lt-b(type='range' min='0' max='200' value='100')
    .mam-loose-panel__row
      label(for='lt-s')=global.__('Subdivisions')
      output#lt-sv
      input#lt-s(type='range' min='1' max='17' value='9')
    .mam-loose-panel__row
      label(for='lt-g')=global.__('Gap')
      output#lt-gv
      input#lt-g(type='range' min='0' max='1000' value='6')
    p.mam-loose-panel__foot=global.__('Move the mouse over the logo. Repeated clicks = cumulative energy. Esc closes.')
    p.mam-loose-panel__foot by V3rbo
script.
  (function(){
  "use strict";
  var cv=document.getElementById("mam-loose-canvas");
  var wrap=document.getElementById("mam-loose-wrap");
  var btn=document.getElementById("mam-loose-btn");
  var dragHandle=document.getElementById("mam-loose-drag");
  var toggleEl=document.getElementById("mam-loose-toggle");
  var panel=document.getElementById("mam-loose-panel");
  if(!cv||!wrap||!btn||!dragHandle||!toggleEl||!panel) return;
  var ctx=cv.getContext("2d");
  var W=0,H=0,DPR=1,scale=1,ox=0,oy=0;
  var parts=[];
  var P={R:420,F:300,K:100,D:0.990,B:80,S:9,G:6};
  var mouse={x:-1e5,y:-1e5,on:false};
  var speed=0,boost=1,lastMove=0;
  var pulses=[];
  var inited=false,running=false,raf=0;
  var POLY=[
  "780.9 549.6 715.8 512 715.8 586.8 780.9 624.3 780.9 624.8 813.1 606.2 780.9 587.6 780.9 549.6",
  "813.5 380 780.9 361.2 715.8 398.8 715.8 474 748.7 493 780.9 511.6 780.9 474.4 780.9 436.4 813.5 417.6 846 398.8 813.5 380",
  "1041.4 511.6 976.3 549.2 976.3 624.4 1009.2 643.4 1041.4 662 1041.4 624.8 1041.4 586.8 1074 568 1106.5 549.2 1074 530.4 1041.4 511.6",
  "1204.2 492.8 1139.1 455.2 1074 492.8 1139.1 530.4 1171.6 511.6 1204.2 530.4 1204.2 492.8",
  "1041.4 700 976.3 662.4 976.3 737.2 1041.4 774.7 1041.4 775.2 1073.6 756.6 1041.4 738 1041.4 700",
  "911.1 436.8 846 474.4 846 549.6 878.9 568.6 911.1 587.2 911.1 550.1 911.1 512 943.7 493.2 976.2 474.4 943.7 455.6 911.1 436.8",
  "1073.9 418 1008.8 380.4 943.7 418 1008.8 455.6 1041.3 436.8 1073.9 455.7 1073.9 418",
  "943.7 342.4 878.6 304.8 813.5 342.4 878.6 380 911.1 361.2 943.7 380 943.7 342.4"
  ].map(function(s){var n=s.trim().split(/\s+/).map(Number),p=[];for(var i=0;i<n.length;i+=2)p.push([n[i],n[i+1]]);return p;});
  var MINX=1e9,MINY=1e9,MAXX=-1e9,MAXY=-1e9;
  POLY.forEach(function(p){p.forEach(function(v){if(v[0]<MINX)MINX=v[0];if(v[0]>MAXX)MAXX=v[0];if(v[1]<MINY)MINY=v[1];if(v[1]>MAXY)MAXY=v[1];});});
  var LW=MAXX-MINX,LH=MAXY-MINY;
  function inside(pt,poly){var x=pt[0],y=pt[1],c=false;for(var i=0,j=poly.length-1;i<poly.length;j=i++){var xi=poly[i][0],yi=poly[i][1],xj=poly[j][0],yj=poly[j][1];if(((yi>y)!==(yj>y))&&(x<(xj-xi)*(y-yi)/(yj-yi)+xi))c=!c;}return c;}
  function insideAny(pt){for(var i=0;i<POLY.length;i++)if(inside(pt,POLY[i]))return true;return false;}
  var GX=32.55,GY=18.8,AX=715.8,AY=304.8;
  function build(){var n=P.S,gx=GX/n,gy=GY/n;parts=[];var i0=Math.floor((MINX-GX*2-AX)/gx),i1=Math.ceil((MAXX+GX*2-AX)/gx),j0=Math.floor((MINY-GY*2-AY)/gy),j1=Math.ceil((MAXY+GY*2-AY)/gy);for(var j=j0;j<=j1;j++){for(var i=i0;i<=i1;i++){if(((i+j)&1)===0)continue;var px=AX+i*gx,py=AY+j*gy;addTri(px,py,px,py+2*gy,px+gx,py+gy);addTri(px,py,px,py+2*gy,px-gx,py+gy);}}}
  function addTri(ax,ay,bx,by,cx,cy){var gx=(ax+bx+cx)/3,gy=(ay+by+cy)/3;if(!insideAny([gx,gy]))return;parts.push({hx:gx,hy:gy,x:gx,y:gy,vx:0,vy:0,a:0,va:0,ha:0,ph:Math.random()*Math.PI*2,sp:0.5+Math.random(),v:[[ax-gx,ay-gy],[bx-gx,by-gy],[cx-gx,cy-gy]]});}
  function resize(){DPR=Math.min(window.devicePixelRatio||1,2);W=cv.clientWidth;H=cv.clientHeight;cv.width=Math.round(W*DPR);cv.height=Math.round(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);var m=Math.min(W,H)*0.10;scale=Math.min((W-2*m)/LW,(H-2*m)/LH);ox=W/2-(MINX+LW/2)*scale;oy=H/2-(MINY+LH/2)*scale;}
  function step(dt,t){speed*=Math.pow(0.08,dt);boost=1+1.2*(1-Math.exp(-speed/1500));var R=P.R*boost/scale,R2=R*R,F=P.F*0.9,K=P.K/100,D=Math.pow(P.D,dt*60),B=P.B/100,mx=(mouse.x-ox)/scale,my=(mouse.y-oy)/scale;for(var i=0;i<parts.length;i++){var p=parts[i];if(B>0){var fx=Math.sin(t*0.6*p.sp+p.ph)+Math.sin(t*0.23+p.hy*0.02),fy=Math.cos(t*0.5*p.sp+p.ph*1.7)+Math.cos(t*0.19+p.hx*0.02);p.vx+=fx*B*6*dt;p.vy+=fy*B*6*dt;p.va+=Math.sin(t*0.8*p.sp+p.ph)*B*0.6*dt;}if(mouse.on){var dx=p.x-mx,dy=p.y-my,d2=dx*dx+dy*dy;if(d2<R2&&d2>0.0001){var d=Math.sqrt(d2),f=1-d/R;f=f*f*(3-2*f);var amp=F*f/(d*0.06+1);p.vx+=(dx/d)*amp*dt;p.vy+=(dy/d)*amp*dt;p.va+=(dx*0.0004-dy*0.0004)*amp*dt;}}for(var q=0;q<pulses.length;q++){var pu=pulses[q],PR=R*(1+0.35*Math.min(pu.e,4)),ddx=p.x-pu.x,ddy=p.y-pu.y,dd2=ddx*ddx+ddy*ddy;if(dd2<PR*PR&&dd2>0.0001){var dd=Math.sqrt(dd2),ff=1-dd/PR;ff=ff*ff*(3-2*ff);var aa=F*2.2*pu.e*ff/(dd*0.05+1);p.vx+=(ddx/dd)*aa*dt;p.vy+=(ddy/dd)*aa*dt;p.va+=(ddx-ddy)*0.0006*aa*dt;}}p.vx+=(p.hx-p.x)*K*60*dt;p.vy+=(p.hy-p.y)*K*60*dt;p.va+=(p.ha-p.a)*K*30*dt;p.vx*=D;p.vy*=D;p.va*=D;p.x+=p.vx*dt;p.y+=p.vy*dt;p.a+=p.va*dt;}for(var q=pulses.length-1;q>=0;q--){pulses[q].e*=Math.pow(0.30,dt);if(pulses[q].e<0.02)pulses.splice(q,1);}}
  function draw(){ctx.clearRect(0,0,W,H);var shrink=1/(1+P.G/100);ctx.lineJoin="round";ctx.fillStyle="#f2f2f2";for(var i=0;i<parts.length;i++){var p=parts[i],ca=Math.cos(p.a),sa=Math.sin(p.a),X=p.x*scale+ox,Y=p.y*scale+oy;ctx.beginPath();for(var j=0;j<3;j++){var vx=p.v[j][0]*shrink,vy=p.v[j][1]*shrink,rx=(vx*ca-vy*sa)*scale,ry=(vx*sa+vy*ca)*scale;if(j===0)ctx.moveTo(X+rx,Y+ry);else ctx.lineTo(X+rx,Y+ry);}ctx.closePath();ctx.fill();}}
  var last2=0;
  function loop(now){if(!running)return;var dt=last2?Math.min((now-last2)/1000,0.033):0.016;last2=now;step(dt,now/1000);draw();raf=requestAnimationFrame(loop);}
  // panel controls
  function readCtrls(){
    P.R=+document.getElementById("lt-r").value; document.getElementById("lt-rv").textContent=P.R+" px";
    P.F=+document.getElementById("lt-f").value; document.getElementById("lt-fv").textContent=P.F;
    P.K=+document.getElementById("lt-k").value; document.getElementById("lt-kv").textContent=(P.K/100).toFixed(2);
    P.D=+document.getElementById("lt-d").value/1000; document.getElementById("lt-dv").textContent=P.D.toFixed(3);
    P.B=+document.getElementById("lt-b").value; document.getElementById("lt-bv").textContent=P.B;
    P.S=+document.getElementById("lt-s").value; document.getElementById("lt-sv").textContent=P.S+"×";
    P.G=+document.getElementById("lt-g").value; document.getElementById("lt-gv").textContent=(P.G/100).toFixed(2);
  }
  ["lt-r","lt-f","lt-k","lt-d","lt-b","lt-g"].forEach(function(id){var el=document.getElementById(id);if(el)el.addEventListener("input",readCtrls);});
  var sEl=document.getElementById("lt-s");
  if(sEl)sEl.addEventListener("input",function(){readCtrls();if(inited)build();});
  readCtrls();
  function init(){if(inited)return;inited=true;build();window.addEventListener("resize",function(){if(running)resize();});cv.addEventListener("pointermove",function(e){var r=cv.getBoundingClientRect(),nx=e.clientX-r.left,ny=e.clientY-r.top,now=performance.now();if(mouse.on&&lastMove){var dt2=Math.max((now-lastMove)/1000,0.004),v=Math.hypot(nx-mouse.x,ny-mouse.y)/dt2;speed+=(v-speed)*0.35;}lastMove=now;mouse.x=nx;mouse.y=ny;mouse.on=true;});cv.addEventListener("pointerdown",function(e){var r=cv.getBoundingClientRect();mouse.x=e.clientX-r.left;mouse.y=e.clientY-r.top;mouse.on=true;var lx=(mouse.x-ox)/scale,ly=(mouse.y-oy)/scale,merged=false,tol=(P.R/scale)*0.35;for(var q=0;q<pulses.length;q++){var ddx=pulses[q].x-lx,ddy=pulses[q].y-ly;if(ddx*ddx+ddy*ddy<tol*tol){pulses[q].e=Math.min(pulses[q].e+1,8);pulses[q].x=(pulses[q].x+lx)/2;pulses[q].y=(pulses[q].y+ly)/2;merged=true;break;}}if(!merged)pulses.push({x:lx,y:ly,e:1});});cv.addEventListener("pointerleave",function(){mouse.on=false;});}
  function show(){init();cv.classList.add("is-active");btn.classList.add("is-active");panel.removeAttribute("hidden");resize();running=true;last2=0;raf=requestAnimationFrame(loop);}
  function hide(){cv.classList.remove("is-active");btn.classList.remove("is-active");panel.setAttribute("hidden","");running=false;cancelAnimationFrame(raf);}
  var barsEl=btn.querySelector(".mam-loose-btn__bars");
  var labelEl=btn.querySelector(".mam-loose-btn__label");
  // burger/X: canvas chiuso → apre canvas+panel; canvas aperto → togogla solo il panel
  barsEl.addEventListener("click",function(e){
    e.stopPropagation();
    if(!running){show();}
    else{if(panel.hidden)panel.removeAttribute("hidden");else panel.setAttribute("hidden","");}
  });
  // label: canvas chiuso → apre; canvas aperto → chiude canvas+panel
  labelEl.addEventListener("click",function(e){
    e.stopPropagation();
    if(!running)show();else hide();
  });
  window.addEventListener("keydown",function(e){if(e.key==="Escape"&&running)hide();});
  // drag on wrap
  var dragging=false,dragOffX=0,dragOffY=0;
  dragHandle.addEventListener("pointerdown",function(e){
    dragging=true;
    var r=wrap.getBoundingClientRect();
    dragOffX=e.clientX-r.left;
    dragOffY=e.clientY-r.top;
    dragHandle.setPointerCapture(e.pointerId);
    if(!wrap.style.left){wrap.style.right="auto";wrap.style.left=r.left+"px";wrap.style.top=r.top+"px";}
    e.preventDefault();
  });
  window.addEventListener("pointermove",function(e){if(!dragging)return;wrap.style.left=(e.clientX-dragOffX)+"px";wrap.style.top=(e.clientY-dragOffY)+"px";});
  window.addEventListener("pointerup",function(){dragging=false;});
  })();
