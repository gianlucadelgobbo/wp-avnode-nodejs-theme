div(itemprop="organizer", itemscope, itemtype='http://schema.org/Organization')
  .logofooter
    a(href=lang_preurl + '/', title=config.project_name)
      i(class="icon-"+(config.prefix=="mam" ? "wam" : config.prefix=="fotonica" ? "f" : (config.prefix=="linuxclub" ? "linux" : config.prefix+(config.prefix=="lcf" ? "-fill" : ""))), itemprop='logo')
      .sr-only=config.project_name
  br
  strong(itemprop='name')=config.project_name
  br
  !=global.__("a project of")+" Flyer new media"
  br
  span(itemprop='location', itemscope, itemtype='http://schema.org/Place')
    span(itemprop='address', itemscope, itemtype='http://schema.org/PostalAddress')
      span(itemprop='streetAddress') Corso d'Italia 37/D
      br
      span(itemprop='postalCode') 00198
      !=" "
      span(itemprop='addressLocality')=global.__('Rome')
      !=" "
      span(itemprop='addressCountry')=global.__('Italy')
    br
    span.d-none(itemprop='geo', itemscope, itemtype='http://schema.org/GeoCoordinates')
      span(itemprop='latitude') 41.9113921
      | ,
      span(itemprop='longitude') 12.4926342
    a(itemprop='url', title=global.__('map'), href='https://maps.app.goo.gl/JiaXTbMg9aKsib1R8', target='_blank')=global.__('map')
    br
  |    Tel.
  !=" "
  a(href='tel:+390678147301', itemprop='telephone', title=global.__('Phone number')) +39 06 78147301
  br
  !=global.__('VAT N°')
  !=" "
  span(itemprop='vatID') IT06589171005
  br
  a(itemprop='email', title=global.__('Write to') + " " + config.project_name, href='mailto:' + config.project_email)=config.project_email
  br.sr-only
  a.sr-only(itemprop='url', title=config.project_name+" Web Site", href=config.domain)=config.domain
