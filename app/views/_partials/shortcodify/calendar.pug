- var events = body.events || []
- var basepage = req_params.page || 'calendar'
.row.avnode-calendar
  each event in events
    .col-md-6.col-lg-4.mb-4
      a(href=lang_preurl + '/' + basepage + '/' + event.slug)
        .card.h-100
          if event.imageFormats && event.imageFormats.large
            img.card-img-top(src=event.imageFormats.large alt=event.title)
          .card-body
            h5.card-title=event.title
            if event.boxDate
              p.card-text.text-muted=event.boxDate
            if event.boxVenue
              p.card-text.small.text-muted=event.boxVenue
