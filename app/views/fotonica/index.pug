extends layout
block content
  if carousel && carousel.length
    #mycarousel.carousel.slide(data-ride='carousel', data-interval='4000')
      .carousel-inner
        each item, i in carousel
          .carousel-item(class=i===0?'active':'')
            if item.link
              a(href=(item.link.startsWith('http') ? item.link : lang_preurl+item.link), title=item.alt)
                if item.src_v
                  img.w-100.d-none.d-sm-block(src=item.src, alt=item.alt)
                  img.w-100.d-sm-none(src=item.src_v, alt=item.alt)
                else
                  img.img-fluid(src=item.src, alt=item.alt)
            else
              if item.src_v
                img.w-100.d-none.d-sm-block(src=item.src, alt=item.alt)
                img.w-100.d-sm-none(src=item.src_v, alt=item.alt)
              else
                img.img-fluid(src=item.src, alt=item.alt)
  //-.embed-responsive.embed-responsive-16by9(style="margin-top:65px")
    iframe.embed-responsive-item(title="avnode-player" src="https://www.facebook.com/plugins/video.php?height=314&href=https%3A%2F%2Fwww.facebook.com%2Ffotonicafestival%2Fvideos%2F162656033567982%2F&show_text=false&width=560&t=0"  width="1920" height="1080" style="border:none;overflow:hidden" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" autoplay="true")
    //iframe.embed-responsive-item(src="https://www.facebook.com/plugins/video.php?height=1080&href=https%3A%2F%2Fwww.facebook.com%2Ffotonicafestival%2Fvideos%2F812473783285537%2F&show_text=false&width=1920&t=0" width="1920" height="1080" style="border:none;overflow:hidden" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" autoplay="true")
  //-.container-fluid
    .embed-responsive.embed-responsive-16by9
      iframe(height="378" width="620" src="https://player.twitch.tv/?channel=vjtelevision&parent=fotonicafestival.com" frameborder="0" allowfullscreen="true" scrolling="no")
    .row
      .col-lg-9.p-md-0
        .embed-responsive.embed-responsive-16by9
          iframe(height="378" width="620" src="https://player.twitch.tv/?channel=vjtelevision&parent=fotonicafestival.com" frameborder="0" allowfullscreen="true" scrolling="no")
      .col-lg-3.p-md-0
        .chat(style="height: 100%;width: 100%;min-height: 300px;")
          iframe(style="height: 100%;width: 100%;" id="chat_embed" src="https://www.twitch.tv/embed/vjtelevision/chat?parent=fotonicafestival.com" height="500" width="350" frameborder="0" scrolling="no")
      
  section.home.mt-5(itemscope, itemtype='http://schema.org/ItemList')
    .container-fluid
      h1.entry-title(itemprop="name") Productions
    .swiper-container
      !=results.editions.replace(new RegExp("col-xl-3 col-lg-4 col-md-6 col-sm-6 col-xs-12 isotopeitem", 'g'), "swiper-slide").replace(new RegExp("row isotope results", 'g'), "swiper-wrapper").replace(new RegExp("pagination pagination-sm justify-content-center", 'g'), "pagination pagination-sm justify-content-center d-none")
    .container-fluid
      .text-right.boxItem
        a.btn.btn-primary.btn-sm(href="/events/", title="See all Editions") See all Productions

  section.home(itemscope, itemtype='http://schema.org/ItemList')
    .container-fluid
      h1.entry-title(itemprop="name") News
    .swiper-container
      !=results.news.replace(new RegExp("col-xl-3 col-lg-4 col-md-6 col-sm-6 col-xs-12 isotopeitem", 'g'), "swiper-slide").replace(new RegExp("row isotope results", 'g'), "swiper-wrapper").replace(new RegExp("pagination pagination-sm justify-content-center", 'g'), "pagination pagination-sm justify-content-center d-none")
    .container-fluid
      .text-right.boxItem
        a.btn.btn-primary.btn-sm(href="/news/", title="See all News") See all News
        
  section.home(itemscope, itemtype='http://schema.org/ItemList')
    .container-fluid
      h1.entry-title(itemprop="name") Satellite Events
    .swiper-container
      !=results.events.replace(new RegExp("col-xl-3 col-lg-4 col-md-6 col-sm-6 col-xs-12 isotopeitem", 'g'), "swiper-slide").replace(new RegExp("row isotope results", 'g'), "swiper-wrapper").replace(new RegExp("pagination pagination-sm justify-content-center", 'g'), "pagination pagination-sm justify-content-center d-none")
    .container-fluid
      .text-right.boxItem
        a.btn.btn-primary.btn-sm(href="/partnerships/", title="See all Events") See all Events

